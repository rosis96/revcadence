# Copy to .env for local dev. NEVER commit real values.
# Railway: set these in the service → Variables tab instead.

# Postgres connection. Railway: ${{Postgres.DATABASE_URL}}. Omit locally to use SQLite.
DATABASE_URL=

# Long random string — sign-in tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional
ACCESS_TOKEN_HOURS=12
WORKER_POLL_SECONDS=5

# Required for real enrichment. Set on both Railway web and worker services.
OPENAI_API_KEY=
EXTRACT_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini

# Visual evidence is bounded to the highest-value website images. Set 0 to disable.
ENRICH_IMAGE_VISION=1

# Optional but strongly recommended for JS-rendered prospect sites.
# RENDER_PROVIDER supports: scrapingbee, scraperapi, browserless.
RENDER_PROVIDER=
RENDER_API_KEY=
# Browserless only; defaults to https://chrome.browserless.io when omitted.
RENDER_API_URL=
RENDER_MAX_PAGES=15
