# Copy to .env for local dev. NEVER commit real values.
# Railway: set these in the service → Variables tab instead.

# Postgres connection. Railway: ${{Postgres.DATABASE_URL}}. Omit locally to use SQLite.
DATABASE_URL=

# Long random string — sign-in tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional. Keep JWT_SECRET stable across deploys or all signed-in sessions will
# become invalid. Access tokens last 30 days; the secure refresh session slides
# for 180 days whenever the app is reopened.
ACCESS_TOKEN_HOURS=720
REFRESH_TOKEN_DAYS=180
WORKER_POLL_SECONDS=5

# Required for real enrichment. Set on both Railway web and worker services.
OPENAI_API_KEY=
# Cost/quality defaults for this input-heavy workflow. Existing Railway overrides
# continue to win; no production variable is changed by this file.
EXTRACT_MODEL=gpt-5-mini
WRITER_MODEL=gpt-5-mini
VISION_MODEL=gpt-5-mini
REPLY_OPENAI_MODEL=gpt-5-mini

# Visual evidence is bounded to the highest-value website images. Set 0 to disable.
ENRICH_IMAGE_VISION=1

# Optional but strongly recommended for JS-rendered prospect sites.
# RENDER_PROVIDER supports: scrapingbee, scraperapi, browserless.
RENDER_PROVIDER=
RENDER_API_KEY=
# Browserless only; defaults to https://chrome.browserless.io when omitted.
RENDER_API_URL=
RENDER_MAX_PAGES=15

# Optional private storage roots. Both must live outside the served frontend
# directory; use a persistent volume in production when files must survive a
# service redeploy.
FORM_UPLOAD_DIR=
WHITEBOARD_ASSET_DIR=

# ---------------------------------------------------------------- system mail
# Mail RevCadence sends AS ITSELF: client workspace invites and their temporary
# password. NOT campaign mail — that still goes through each workspace's
# connected mailbox under the client's own name.
#
# Leave these blank and invites fall back to any mailbox connected under
# Settings → Email Accounts. With neither, the invite is still CREATED and the
# admin screen shows the credentials to deliver by hand — nothing is lost, and
# the UI says plainly that no email went out.
#
# Any SMTP submission service works (Gmail/Workspace app password, Microsoft 365,
# Amazon SES, Resend, Postmark, Mailgun, Brevo, …). Port 465 uses implicit TLS;
# anything else uses STARTTLS.
#   Gmail / Workspace : smtp.gmail.com        587   app password, not the login password
#   Microsoft 365     : smtp.office365.com    587
#   Amazon SES        : email-smtp.<region>.amazonaws.com 587
#   Resend            : smtp.resend.com       587   username "resend", password = API key
#   Postmark          : smtp.postmarkapp.com  587   username = password = server token
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The address invites come FROM. Must be one the provider above is allowed to send as.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=RevCadence

# The OPERATOR origin, no trailing slash (e.g. https://engine.revcadence.com).
# This one is load-bearing: it is the OAuth redirect URI registered with Google
# and Microsoft, and the inbound capture endpoint clients paste into their site.
# Changing it breaks both, so it is not the setting to move for nicer links —
# CLIENT_BASE_URL below is. Falls back to the request's own origin.
PUBLIC_BASE_URL=

# Optional dedicated CLIENT origin, no trailing slash (e.g. https://app.revcadence.com).
# Every client link is a real path: <origin>/client/<workspace-slug>. Leave this
# unset to use the deployed RevCadence origin from PUBLIC_BASE_URL, which is the
# normal setup when the portal lives at revcadence.com/client/….
CLIENT_BASE_URL=

# Extra hosts that serve the client app rather than the operator one. Anything
# starting `app.` is recognised already; this is for hosts that are not shaped
# that way, such as a client's own vanity domain. Comma-separated, host only.
CLIENT_HOSTS=
